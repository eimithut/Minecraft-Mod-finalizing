// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: mods
// Document ID: auto-generated
// Fields:
//   - name: string (required, 1-100 chars)
//   - description: string (optional, 0-500 chars)
//   - author: string (required, 1-50 chars)
//   - createdAt: timestamp (required)
//   - downloadUrl: string (required, URL)
//   - version: string (optional)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidMod(data) {
      return data.keys().hasAll(['name', 'author', 'createdAt', 'downloadUrl']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.author is string && data.author.size() > 0 && data.author.size() <= 50 &&
             data.createdAt is timestamp &&
             data.downloadUrl is string && data.downloadUrl.matches("^https?://.*") &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('version' in data) || (data.version is string));
    }

    match /mods/{modId} {
      // Allow anyone to read the gallery
      allow read: if true;
      
      // Allow anyone to share a mod (for this demo, we don't require login to keep it accessible)
      // but we validate the data strictly
      allow create: if isValidMod(request.resource.data);
      
      // No updates or deletes allowed by users for now
      allow update, delete: if false;
    }
  }
}
