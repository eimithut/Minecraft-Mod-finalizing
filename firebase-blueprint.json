{
  "entities": {
    "Mod": {
      "title": "Mod",
      "description": "A Minecraft mod shared in the gallery",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the mod"
        },
        "description": {
          "type": "string",
          "description": "A short description of the mod"
        },
        "author": {
          "type": "string",
          "description": "The name of the creator"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the mod was shared"
        },
        "downloadUrl": {
          "type": "string",
          "description": "The temporary download link for the .jar file"
        },
        "version": {
          "type": "string",
          "description": "Minecraft version"
        }
      },
      "required": ["name", "author", "createdAt", "downloadUrl"]
    }
  },
  "firestore": {
    "/mods": {
      "schema": "Mod",
      "description": "Public gallery of Minecraft mods"
    }
  }
}
